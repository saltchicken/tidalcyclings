setcps (135/60/4)

let parts = 
      [ ("bass", note "a2 ~ c3 e3" # r2)
      , ("lead", note "a4(3,8) e4(3,8,2)" # r1)
      , ("arp", struct "[t ~ t t]*4" $ note (scale "minor" "0 2 4 7") # r3)
      , ("drums", stack [ bd "1*4", ch "1*8", struct "~ t ~ ~" $ sn "1" ])
      , ("break", stack [ bd "1(3,8)", fast 2 $ ch "1", struct "~ t ~ ~" $ cp "1" ])
      ]
    fx = 
      [ ("fill", fast 2)
      , ("slowdown", slow 2)
      , ("octup", (|+ note 12)) -- standard Tidal syntax for adding to notes
      , ("stutter", stut 4 0.6 (1/16))
      , ("jux", jux rev)
      , ("echo", (# delay 0.5) . (# delaytime 0.25) . (# delayfeedback 0.6))
      , ("crush", (# crush 4))
      ]

d1 $ ur 8 (
  "[bass:fill] [bass, arp] [bass, arp, drums] [break:fill, arp:octup]\
  \[bass, lead, arp, drums] [bass, lead:stutter, arp, drums] [bass, lead:jux, break:fill, arp] [arp:slowdown]"
) parts fx
