do
  interpolateIn "tempo" 2 $ cps (128/60/4)
  let parts = 
        [ -- Bass 1: Steady, driving off-beat house bass
          ("bass", note (scale "dorian" "~ 0 ~ -1 ~ 2 ~ -2" |+ "d3") # bass)
          
          -- Bass 2: Syncopated, bouncy acid-style line
        , ("bass2", note (scale "dorian" "0 [~ 3] -1 [2 ~] <4 5> 0 [~ -2] 0" |+ "d3") # bass)
          
          -- Pluck: Evolving 16th note arpeggio
        , ("arp", struct "t(11,16)" $ note (scale "dorian" "<0 2> 4 <5 7> 2" |+ "d4") # pluck)
        
          -- Lead: Sparse, atmospheric stabs that change pitch every cycle
        , ("lead", struct "~ ~ t ~" $ note "<d5 f5 a5 c6>" # lead)

          -- Drone: Deep underlying root pad
        , ("pad", slow 16 $ note "<[d3, f3] [e3, g3]>" # drone # legato 1)
          
          -- Standard 4-on-the-floor house beat
        , ("drums", stack [ bd "1*4", ch "~ 1 ~ 1", cp "~ 1 ~ 1" ])
          
          -- Heavy break with toms and open hats for transitions
        , ("break", stack [ bd "1(3,8)", lt "1 ~ 1 ~", ht "~ 1 ~ 1", fast 2 $ sn "1" ])
        ]
      fx = 
        [ ("fill", fast 2)
        , ("halftime", slow 2)
        , ("octup", (|+ note 12)) 
        , ("octdown", (|- note 12)) 
        , ("delay", stut 3 0.6 (1/8)) -- Eighth-note delay simulation
        , ("echo5th", off 0.25 (|+ note 7))
        , ("echoOct", off 0.125 (|+ note 12)) -- Quick octave slapback
        , ("chord", superimpose (|+ note 7))
        , ("staccato", (# legato 0.2))
        , ("sustain", (# legato 2))
        , ("shift", iter 4) -- Shifts the pattern starting point 
        , ("jumble", jux rev) -- Plays reverse on one side (if MIDI pan is mapped)
        ]
  xfadeIn 1 2 $ ur 8 (
    "[pad, bass, drums, arp:staccato] \
    \[pad, bass2:echoOct, drums, arp:shift] \
    \[pad, bass:octdown, drums, arp:delay, lead:echo5th] \
    \[pad, break:fill, arp:jumble, lead:chord]"
    ) parts fx
